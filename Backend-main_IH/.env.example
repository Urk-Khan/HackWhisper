# =====================================================================
# HackWhisper: AI Hacktoberfest Voice Calling Agent Configuration
# =====================================================================

# ---- 1. Telephony: Telnyx (Recommended for Voice & SMS) ----
# Telnyx Portal -> API Keys:
TELNYX_API_KEY=
TELNYX_PHONE_NUMBER=+18555010702
TELNYX_ACCOUNT_SID=
TELNYX_TEXML_APP_ID=

# Optional: Live Call Transfer (organizer / human escalation)
TRANSFER_PHONE_NUMBER=+19177954404

# (Alternative Telephony: SignalWire)
# SIGNALWIRE_SPACE_URL=https://your-space.signalwire.com
# SIGNALWIRE_PROJECT_ID=
# SIGNALWIRE_API_TOKEN=
# SIGNALWIRE_PHONE_NUMBER=


# ---- 2. Speech-to-Text & Text-to-Speech: Cartesia ----
# Get your API key from https://cartesia.ai (Ultra-low latency streaming voice)
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=86e30c1d-714b-4074-a1f2-1cb6b552fb49


# ---- 3. Large Language Model (LLM) ----
LLM_PROVIDER=openai              # openai | anthropic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini         # Fast, low-latency reasoning model for voice

# Optional Anthropic Claude:
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022


# ---- 4. Hacktoberfest Events Data Source ----
# Direct official MLH Hacktoberfest Events JSON API
HACKTOBERFEST_EVENTS_API=https://hacktoberfest-api.mlh.com/api/events


# ---- 5. Database: PostgreSQL / Supabase ----
# Used for storing events, historical versioning, sync logs, and call records.
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Optional Supabase (fallback):
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=


# ---- 6. Email Dispatch: Resend (For sending event details & links) ----
# Get free API key from https://resend.com
RESEND_API_KEY=
RESEND_FROM_ADDRESS=Hacktoberfest Assistant <onboarding@resend.dev>


# ---- 7. Server & Timezone Settings ----
HOST=0.0.0.0
PORT=7860
TIMEZONE=UTC
LOG_LEVEL=INFO
